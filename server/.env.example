# Copy this file to ".env" and fill in your own values. Never share the real .env file.

# MongoDB connection string. Free option: MongoDB Atlas. Local option: mongodb://127.0.0.1:27017/store
MONGODB_URI=mongodb://127.0.0.1:27017/store

# Any long random text. It is used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-text

# Address of the website. Use your Netlify link here after you deploy (several links can be separated by commas).
CLIENT_ORIGIN=http://localhost:5173

PORT=5000

# Used only by "npm run seed" to create your admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Delivery charges in PKR. Change these to your own rates.
SHIPPING_FEE=200
FREE_SHIPPING_OVER=5000
